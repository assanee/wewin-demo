# The one file. Copy it to `.env` here at the workspace root and every entry point finds
# it: the API at boot and under test, packages/db's tests, `db:migrate` and `db:seed`.
# Each walks up from its own directory and stops at pnpm-workspace.yaml, so a `.env` inside
# a package still wins — which is how you point migrations at a scratch server without
# repointing everything else. Anything already exported wins over both; process.loadEnvFile
# fills gaps, it does not overwrite.
#
# Port 5433 matches docker-compose.yml beside this file. Nothing defaults it: `pnpm db:seed`
# truncates the catalogue, and a default is how that lands on a database somebody cared about.
DATABASE_URL=postgres://wewin:wewin@localhost:5433/wewin

# apps/api has more knobs — apps/api/.env.example lists them. One is worth knowing about
# here: in production the API refuses to boot without AUTH_ACCESS_TOKEN_SECRET, because a
# default access-token signing key is a key in the repository. Outside production it mints
# an ephemeral one per process and warns, so `pnpm dev` and the test suite run unchanged.


# ─────────────────────────────────────────────────────────────────────────────
# Signing in to the dashboard on a laptop
# ─────────────────────────────────────────────────────────────────────────────
# All four are apps/api's settings. They live here rather than in apps/dashboard/.env
# because that file is `NEXT_PUBLIC_` only — it is substituted into the browser bundle —
# and none of these belong there.
#
# ⚠️ Without CORS_ORIGINS the dashboard's login page says "ติดต่อ API ไม่ได้" while the API
# is perfectly healthy, because the browser cannot tell a missing CORS header from a dead
# server. It is the single most confusing way this setup fails.

CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Where a completed OAuth sign-in lands. There is exactly ONE and the storefront and the
# dashboard share it, so while working on the dashboard it points here and while working on
# apps/web it has to point there. Password sign-in never leaves its origin and does not use
# it — the API still reads it at boot.
OAUTH_WEB_BASE_URL=http://localhost:3001

# Every cookie in the flow is `Secure` by default and a laptop has no TLS terminator. Not a
# production foot-gun: the API refuses this value unless the callback base is a loopback
# address, so it cannot be the thing a deployment forgot.
COOKIE_SECURE=false

# The page a password-reset link points at. Read at boot rather than built per request from
# a `Host` header, because a caller controls that header and a reset link is a credential.
PASSWORD_RESET_URL_BASE=http://localhost:3001/reset-password

# Where reset emails are written instead of sent — `file` is the default transport.
#
# ⚠️ **An absolute path, and it has to be.** A relative one resolves against the *process's*
# working directory, not against this file: `pnpm dev` runs the API from `apps/api`, so
# `./tmp/mail` put the messages in `apps/api/tmp/mail` while everybody looked in the root.
# Change the prefix if you move the checkout.
#
# The body is base64. To read the link:
#   python3 -c "import base64,glob,sys; f=sorted(glob.glob('tmp/mail/*.eml'))[-1]; \
#     print(base64.b64decode(open(f).read().split(chr(10)*2,1)[1]).decode())"
NOTIFICATIONS_EMAIL_DIR=/absolute/path/to/wewin-demo/tmp/mail
