# The one file. Copy it to `.env` here at the workspace root and every entry point finds
# it: the API at boot and under test, packages/db's tests, `db:migrate` and `db:seed`.
# Each walks up from its own directory and stops at pnpm-workspace.yaml, so a `.env` inside
# a package still wins — which is how you point migrations at a scratch server without
# repointing everything else. Anything already exported wins over both; process.loadEnvFile
# fills gaps, it does not overwrite.
#
# Port 5433 matches docker-compose.yml beside this file. Nothing defaults it: `pnpm db:seed`
# truncates the catalogue, and a default is how that lands on a database somebody cared about.
DATABASE_URL=postgres://wewin:wewin@localhost:5433/wewin

# apps/api has more knobs, all of them with defaults — apps/api/.env.example lists them.
