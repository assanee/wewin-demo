# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Build caches
.turbo
*.tsbuildinfo

# Connection strings and credentials. .env.example is the documented shape and is committed.
.env
.env.*
!.env.example

# Postgres data directory, if docker compose is pointed at a bind mount instead of a volume
pgdata

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Reset emails written by the file transport in development (NOTIFICATIONS_EMAIL_DIR).
tmp/

# Snapshots the Playwright MCP writes while a browser is being driven. Test debris.
.playwright-mcp/

# Subagent-driven-development scratch: ledgers, briefs, review packages.
# Git history is the durable record; this is the controller working memory.
.superpowers/

# Throwaway checkouts an agent works in so parallel branches cannot collide.
# Scoped to `worktrees/` rather than all of `.claude/` on purpose: agents,
# skills and settings.json in there are meant to be shared, and ignoring the
# whole directory would swallow them silently the day somebody adds one.
.claude/worktrees/

# Per-machine Claude Code settings. The shared ones live in settings.json.
.claude/settings.local.json
