# Normally you do not need this file. `cp .env.example .env` at the workspace root is the
# documented setup: this app searches its own directory first and then walks up to the
# root, which is where the one docker-compose.yml lives. Copy this one only to give the
# API settings the rest of the workspace should not have — a file here wins over the root.
#
# Values already present in the real environment win either way — the file fills gaps, it
# does not overwrite (Node's process.loadEnvFile semantics).

# Matches the root docker-compose.yml (host port 5433). The only variable with no default:
# the API refuses to boot without it rather than discovering the problem on its first query.
DATABASE_URL=postgres://wewin:wewin@127.0.0.1:5433/wewin

# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3000
# SERVICE_VERSION=dev

# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# verbose | debug | log | warn | error | fatal
# LOG_LEVEL=log
# pretty | json
# LOG_FORMAT=pretty

# How long readiness reports "draining" before the HTTP server closes. Worth setting
# wherever more than one instance runs behind a load balancer.
# SHUTDOWN_GRACE_MS=0

# Comma-separated. Empty sends no CORS headers at all.
# CORS_ORIGINS=http://localhost:5173
