# Normally you do not need this file. `cp .env.example .env` at the workspace root is the
# documented setup: this app searches its own directory first and then walks up to the
# root, which is where the one docker-compose.yml lives. Copy this one only to give the
# API settings the rest of the workspace should not have — a file here wins over the root.
#
# Values already present in the real environment win either way — the file fills gaps, it
# does not overwrite (Node's process.loadEnvFile semantics).

# Matches the root docker-compose.yml (host port 5433). The only variable with no default:
# the API refuses to boot without it rather than discovering the problem on its first query.
DATABASE_URL=postgres://wewin:wewin@127.0.0.1:5433/wewin

# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3000
# SERVICE_VERSION=dev

# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# verbose | debug | log | warn | error | fatal
# LOG_LEVEL=log
# pretty | json
# LOG_FORMAT=pretty

# How long readiness reports "draining" before the HTTP server closes. Worth setting
# wherever more than one instance runs behind a load balancer.
# SHUTDOWN_GRACE_MS=0

# Comma-separated. Empty sends no CORS headers at all.
# CORS_ORIGINS=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Authentication (phase 3b)
# ─────────────────────────────────────────────────────────────────────────────

# One flag for every cookie this process sets: the OAuth state binding, the refresh token
# and the guest cart. Defaults to `true`, which is the only value that makes `Secure`,
# `SameSite=None` and the `__Host-` prefix real — and those three attributes are the whole
# of the OAuth browser binding. `false` is for a laptop with no TLS terminator, and the API
# refuses to boot with it unless OAUTH_CALLBACK_BASE_URL is a loopback address.
# COOKIE_SECURE=true

# The access-token signing key. 32 bytes of randomness, however it is spelled:
#     node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# There is no default and there never will be — a default key forges tokens for every
# deployment that forgot to set one. In production the API refuses to start without it;
# outside production it mints an ephemeral key per process and says so, so that a fresh
# checkout runs and nobody is tempted to commit a real one.
# AUTH_ACCESS_TOKEN_SECRET=

# `iss` on every access token, and the value verification requires. Change it and every
# token issued by the old value stops being accepted, which is the point.
# AUTH_TOKEN_ISSUER=wewin-api

# Ten minutes, and the number is a decision: an access token is verified by signature alone,
# so this *is* the revocation latency. See src/auth/session/session.config.ts.
# AUTH_ACCESS_TOKEN_TTL_SECONDS=600
# AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# AUTH_SESSION_TTL_SECONDS=7776000

# Plan 6(c). Parallel refreshes from one page all arrive within this window and are all
# served instead of one of them being mistaken for a stolen token. Zero closes it, which is
# how the tests reproduce the bug on demand; zero in production is the bug.
# AUTH_REFRESH_GRACE_SECONDS=15

# ── OAuth ────────────────────────────────────────────────────────────────────
# Mentioning *any* variable for a provider means somebody was configuring it, so a half
# edit stops the process with a list of what is missing. Mentioning none means the provider
# does not exist: `/auth/oauth/line/start` answers 404 and the rest of the API boots. That
# second rule is why this file ships with all of them commented out — there are no real
# credentials in this environment, and "no provider is configured" is the true state here.

# Required as soon as any provider is configured. The first is the site the customer is on
# (every redirect is built from it), the second is where providers send the callback.
# OAUTH_WEB_BASE_URL=http://localhost:5173
# OAUTH_CALLBACK_BASE_URL=http://localhost:3000

# Where a cancelled or failed sign-in lands, as a path on OAUTH_WEB_BASE_URL.
# OAUTH_FAILURE_PATH=/login
# OAUTH_STATE_TTL_SECONDS=600

# LINE is the deciding provider for this project (plan section 6). The channel secret is
# both the `client_secret` and the HMAC key its id_token is signed with.
# OAUTH_LINE_CLIENT_ID=
# OAUTH_LINE_CLIENT_SECRET=

# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=

# Apple's client secret is not a string: it is an ES256 JWT signed per request from the .p8
# key below. All four are required together, or Apple is simply not configured. Newlines in
# the key may be written escaped (\n) — an environment variable is one line and a PEM is not.
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_TEAM_ID=
# OAUTH_APPLE_KEY_ID=
# OAUTH_APPLE_PRIVATE_KEY=
