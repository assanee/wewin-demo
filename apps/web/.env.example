# The origin this build advertises in its canonical and hreflang tags.
#
# It is `NEXT_PUBLIC_` because `metadataBase` is read while the page is rendered, and it is
# declared in turbo.json's `build.env` because it is *baked into the output*: a build that
# ran against one origin produced 648 pages of markup that can only be correct for that
# origin, so pointing it at another must miss the cache.
#
# Unset is a working default (http://localhost:3002) and a deliberate one — a preview
# deployment that advertises production's canonical URL is worse than one that advertises
# none, because a crawler believes it.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# ── Storefront cache invalidation ────────────────────────────────────────────────
#
# The shared secret `POST /api/revalidate` checks. Without it that route answers 503 and
# refuses everything rather than accepting anything — fail-closed, because an open
# invalidation endpoint is a free way to make a shop re-render on demand.
#
# ⚠️ apps/api must hold the SAME value in its own REVALIDATE_TOKEN, or every publish logs a
# 403 and the shop quietly serves stale pages. Not `NEXT_PUBLIC_`: it is read on the server
# only, and a public one would be printed into the bundle.
REVALIDATE_TOKEN=
