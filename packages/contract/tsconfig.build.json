{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],

    /*
     * Node types, NOT DOM — the same call core makes and for the same reason. This
     * package is imported by a NestJS process and by a browser bundle, so anything
     * only one of them has must stay a compile error here.
     */
    "types": ["node"],

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    /* Strictness — spec section 1: no `any`, no `@ts-ignore` */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
