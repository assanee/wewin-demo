# Normally you do not need this file. `cp .env.example .env` at the workspace root is the
# documented setup, and everything here — the tests, `db:migrate`, `db:seed` — searches
# this directory first and then walks up to the root, because the root is where the one
# docker-compose.yml lives.
#
# Copy this one only to point migrations at a different server than the rest of the
# workspace uses. A file here wins over the root file.
DATABASE_URL=postgres://wewin:wewin@localhost:5433/wewin
