{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],

    /*
     * Node types only, for the same reason core takes them: this package talks to a
     * socket, never to a screen. `lib: ["DOM"]` would let a browser API compile here
     * and only fail when apps/api actually ran.
     */
    "types": ["node"],

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    /* Strictness — spec section 1: no `any`, no `@ts-ignore` */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
